{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/home",
            "destination": "/",
            "permanent": true
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/404.html",
            "status": 404
        }
    ]
}